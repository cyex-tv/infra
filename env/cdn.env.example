# tv-cdn (Caddy). Every line is optional and shows its default. To change one, remove the # and
# set a value; to go back to the default, put the # back (don't leave a variable set but empty).
# What each one does: docs/self-hosted-cdn.md. Then: docker compose ... up -d tv-cdn

# Public host name (Caddy gets its TLS certificate for it) and the bucket folder it serves.
# The bucket is created from the same name.
#CDN_HOST=cdn.cyex.tv
#CDN_BUCKET=cyex-tv-cdn

# Per visitor (one IPv4 address, or one IPv6 /64): a steady limit and a short-burst limit.
# Over either one the answer is 429 with a Retry-After header.
#CDN_RATE_EVENTS=600
#CDN_RATE_WINDOW=1m
#CDN_BURST_EVENTS=150
#CDN_BURST_WINDOW=10s
# How many bits of the address identify a visitor. 32 and 64 are one IPv4 address and one IPv6 /64.
#CDN_RATE_IPV4_PREFIX=32
#CDN_RATE_IPV6_PREFIX=64

# Slow clients. Header and body read limits, the time to send a whole response, idle keep-alive.
#CDN_READ_HEADER_TIMEOUT=5s
#CDN_READ_TIMEOUT=10s
#CDN_WRITE_TIMEOUT=30s
#CDN_IDLE_TIMEOUT=30s
#CDN_MAX_HEADER_SIZE=16KB
# The CDN takes no uploads. 1 byte is the smallest limit (0 would switch the limit off).
#CDN_MAX_BODY=1

# Address ranges of a proxy in front of this host, comma or space separated. Leave this commented
# for DNS only (Option A): with nothing in front, nobody may set the visitor's address.
#CDN_TRUSTED_PROXIES=
