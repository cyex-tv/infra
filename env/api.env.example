CYEX_TV_DATABASE_URL=postgres://cyextv:<password>@tv-db:5432/cyextv
CYEX_TV_LOG=info

# Sign-in (ADR 0009). Production defaults: https://api.cyex.tv and https://cyex.tv.
CYEX_TV_TWITCH_CLIENT_ID=
CYEX_TV_TWITCH_CLIENT_SECRET=
CYEX_TV_KICK_CLIENT_ID=
CYEX_TV_KICK_CLIENT_SECRET=

# The owner (ADR 0010): twitch:<user id>,kick:<user id>
CYEX_TV_OWNER_IDS=

# Storage (ADR 0003): the R2 token from platform/docs/setup/owner-steps.md (Phase 3).
CYEX_TV_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
CYEX_TV_S3_BUCKET=cyex-tv-cdn
CYEX_TV_S3_ACCESS_KEY_ID=
CYEX_TV_S3_SECRET_ACCESS_KEY=
CYEX_TV_S3_REGION=auto
CYEX_TV_CDN_URL=https://cdn.cyex.tv

# The cosmetics shop (platform ADR 0016): cyex.tv's OWN Paddle account, never cyex.app's.
# Steps in platform/docs/setup/owner-steps.md ("Paddle for the cyex.tv shop"). Leave empty until
# then: the shop lists items and checkout says it isn't available yet.
# sandbox (empty means sandbox) or production.
CYEX_TV_PADDLE_ENV=
CYEX_TV_PADDLE_API_KEY=
CYEX_TV_PADDLE_CLIENT_TOKEN=
CYEX_TV_PADDLE_WEBHOOK_SECRET=
