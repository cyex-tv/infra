# Read by backups/backup.sh (optional; the same names also work as plain environment variables).
# Copy to /srv/cyex-tv/infra/env/backup.env (or $CYEXTV_ENV_DIR/backup.env); chmod 640, root:docker.

# An rclone remote and bucket for the off-host copy, e.g. r2-backups:cyex-tv-backups
CYEXTV_BACKUP_REMOTE=

# The age PUBLIC key (starts with age1) that dumps are encrypted to before upload.
# Make a key pair on a trusted machine with `age-keygen`; keep the private key off this host.
# Left empty, dumps are uploaded unencrypted and the script warns.
CYEXTV_BACKUP_AGE_RECIPIENT=
