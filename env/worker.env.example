CYEX_TV_DATABASE_URL=postgres://cyextv:<password>@tv-db:5432/cyextv
CYEX_TV_LOG=info

CYEX_TV_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
CYEX_TV_S3_BUCKET=cyex-tv-cdn
CYEX_TV_S3_ACCESS_KEY_ID=
CYEX_TV_S3_SECRET_ACCESS_KEY=
CYEX_TV_S3_REGION=auto
CYEX_TV_CDN_URL=https://cdn.cyex.tv

# Takedowns purge the CDN: an API token with Cache Purge on the cyex.tv zone.
CYEX_TV_CLOUDFLARE_ZONE_ID=
CYEX_TV_CLOUDFLARE_PURGE_TOKEN=
