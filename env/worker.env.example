CYEX_TV_DATABASE_URL=postgres://cyextv:<password>@tv-db:5432/cyextv
CYEX_TV_LOG=info

# Keys: ROOT_ACCESS_KEY and ROOT_SECRET_KEY from s3.env (docs/self-hosted-cdn.md).
CYEX_TV_S3_ENDPOINT=http://tv-s3:7070
CYEX_TV_S3_BUCKET=cyex-tv-cdn
CYEX_TV_S3_ACCESS_KEY_ID=
CYEX_TV_S3_SECRET_ACCESS_KEY=
CYEX_TV_S3_REGION=auto
CYEX_TV_CDN_URL=https://cdn.cyex.tv

# Takedowns purge the CDN: an API token with Cache Purge on the cyex.tv zone. Leave both empty for
# the self-hosted CDN (docs/self-hosted-cdn.md): cdn.cyex.tv isn't proxied, so there is no cache.
CYEX_TV_CLOUDFLARE_ZONE_ID=
CYEX_TV_CLOUDFLARE_PURGE_TOKEN=
