# tv-s3 (versitygw) root keys. Long random values, never the dev ones from the platform's dev
# compose. The same pair goes into api.env and worker.env as CYEX_TV_S3_ACCESS_KEY_ID and
# CYEX_TV_S3_SECRET_ACCESS_KEY (docs/self-hosted-cdn.md).
#   openssl rand -hex 16   (access key)    openssl rand -hex 32   (secret key)
ROOT_ACCESS_KEY=
ROOT_SECRET_KEY=
