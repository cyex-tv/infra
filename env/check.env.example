# For monitoring/check.sh. Copy to /srv/cyex-tv/infra/env/check.env (or $CYEXTV_ENV_DIR/check.env), chmod 640, root:docker. Real values never go in
# this repo or a chat.

# A Discord or Slack-compatible incoming webhook. Unset: alerts are only logged.
CYEXTV_ALERT_WEBHOOK=

# Thresholds (defaults shown).
# CYEXTV_DUE_MAX=100
# CYEXTV_DISK_MAX=80
# CYEXTV_DISK_PATH=/var/lib/docker
# CYEXTV_CDN_URL=https://cdn.cyex.tv
# Hourly: every published emote, badge and paint has its picture on the CDN (needs jq), and how
# long a file the edge doesn't hold yet takes to start, in seconds.
# CYEXTV_API_URL=http://127.0.0.1:8080
# CYEXTV_CDN_PROBE_MAX=2000
# CYEXTV_CDN_MISS_MAX=3

# R2 usage against the free tier, checked hourly (optional; needs jq). The free tier is per
# Cloudflare account, so every bucket on the account counts. Token: an Account API token with
# only "Account Analytics: Read". The account ID is in the R2 endpoint.
# CYEXTV_CF_ACCOUNT_ID=
# CYEXTV_CF_ANALYTICS_TOKEN=
# CYEXTV_R2_WARN_PCT=80
